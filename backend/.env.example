# Comma-separated browser origins; wildcards are intentionally rejected.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Backend-only Supabase Data API configuration. Never expose these in NEXT_PUBLIC_*.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Local Supabase CLI / legacy fallback. Only one elevated key is required.
SUPABASE_SERVICE_ROLE_KEY=
