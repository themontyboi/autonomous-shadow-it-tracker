# Public browser configuration. Never place secrets in NEXT_PUBLIC_* values.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Comma-separated browser origins allowed to call the FastAPI service.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Backend-only Supabase Data API configuration. Leave blank in committed files.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Local/legacy fallback only; set one elevated backend key, not both.
SUPABASE_SERVICE_ROLE_KEY=
